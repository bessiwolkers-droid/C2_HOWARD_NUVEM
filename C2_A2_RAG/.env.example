# Sem chave, o serviço de geração usa o modo simulado offline.
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODELO=gpt-4o-mini
LLM_TIMEOUT=20
LLM_MAX_TENTATIVAS=3
LLM_ESPERA_RETENTATIVA=0.5
# URLs internas usadas em execução sem Docker; o Compose define os nomes de serviço.
URL_INGESTAO=http://localhost:8001
URL_RECUPERACAO=http://localhost:8002
REDIS_URL=redis://localhost:6379/0
INDICE_PATH=./dados/indice.json
